{
  "name": "nuxt-monitor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run build:native && nuxt build",
    "build:native": "vpx scripts/build-native.ts",
    "dev": "vp run build:native && nuxt dev --host 127.0.0.1",
    "start": "vpx scripts/start.ts",
    "test:native": "vp run build:native && .cache/native/monitor --self-test",
    "postinstall": "nuxt prepare",
    "check": "vp check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "typecheck": "nuxt typecheck"
  },
  "devDependencies": {
    "@nuxt/ui": "^4.12.0",
    "@tanstack/charts": "^1.1.0",
    "@types/node": "^26.6.5",
    "nuxt": "^4.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plus": "^1.4.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.15.0"
}
